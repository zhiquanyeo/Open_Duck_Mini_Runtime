[Unit]
Description=Open Duck Mini startup supervisor (gamepad wait + eye animation + walk/head-puppet handoff)
After=multi-user.target

[Service]
Type=simple
# Adjust User/WorkingDirectory/ExecStart for your install location.
User=zq
WorkingDirectory=/home/zq/dev/Open_Duck_Mini_Runtime
ExecStart=/home/zq/.local/bin/uv run duck-startup
Restart=on-failure
RestartSec=2
# Cleanup (motor/thread teardown) can occasionally hang on hardware I/O;
# don't let `systemctl stop` block on the default 90s timeout waiting for it —
# escalate to SIGKILL after 10s so stop commands stay responsive.
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
